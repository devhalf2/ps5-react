+/** @brief Opens a fork for split fade-cache captures (composite_from_cache): its rect and slices. */
+static void fade_fork_begin(const ParallelRenderJob* j)
+{
+#if ER_FADE_CACHE_ENABLED
+    s_fade_fork_x0 = j->x0;
+    s_fade_fork_y0 = j->ry0;
+    s_fade_fork_x1 = j->x1;
+    s_fade_fork_y1 = j->ry1;
+    s_fade_fork_slices = j->nslices;
+    s_fade_fork_claim = 0xFFFFu;
+    memset(s_fade_slices, 0, sizeof(s_fade_slices));
+#else
+    (void)j;
+#endif
+}
+
+/**
+ * @brief Closes the fork: a group captured by every slice holding rows of it owns the cache; a capture
+ *        missing a slice leaves the cache invalid, since the slices that took it overwrote it.
+ */
+static void fade_fork_end(void)
+{
+#if ER_FADE_CACHE_ENABLED
+    const int slices = s_fade_fork_slices;
+    s_fade_fork_slices = 0;
+    const FadeSliceCapture* c = NULL;
+    for (int k = 0; k < slices && !c; k++)
+        if (s_fade_slices[k].captured)
+            c = &s_fade_slices[k];
+    if (!c)
+        return;
+    /* A group that lost the claim asked for a single-core capture next commit; this one was captured
+     * instead, and that frame would only evict it. */
+    s_fade_capture_wanted = false;
+    bool whole = true;
+    const int rows = s_fade_fork_y1 - s_fade_fork_y0;
+    for (int k = 0; k < slices && whole; k++)
+    {
+        const int sy0 = s_fade_fork_y0 + rows * k / slices;
+        const int sy1 = s_fade_fork_y0 + rows * (k + 1) / slices;
+        if (sy0 >= sy1 || sy1 <= c->py || sy0 >= c->py + c->h)
+            continue; /* no rows of the group in this slice */
+        const FadeSliceCapture* s = &s_fade_slices[k];
+        whole = s->captured && s->tag == c->tag && s->px == c->px && s->py == c->py && s->w == c->w && s->h == c->h;
+    }
+    s_fade_capture_commit = s_commit_seq;
+    if (!whole)
+    {
+        s_fade_cache_tag = 0xFFFFu;
+        return;
+    }
+    s_fade_cache_tag = c->tag;
+    s_fade_cache_used = s_commit_seq;
+    s_fade_cache_gen = s_content_gen;
+    s_fade_cache_w = c->w;
+    s_fade_cache_h = c->h;
+#endif
+}
