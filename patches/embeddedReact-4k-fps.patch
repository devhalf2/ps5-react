     }
 
+#if ERUI_FADE_CACHE_W >= FB_W && ERUI_FADE_CACHE_H >= FB_H
+    /* ================================================================================
+     * Fade cache: a fading group as tall as the fork's rect is captured by the slices, each its
+     * own rows, so every frame of the fade forks (no single-core capture frame), and each frame
+     * matches the same alpha rendered single-core. A second, smaller group fading over it in the
+     * same frames (a tab dimming as the page fades) must not capture into the same buffer.
+     * ================================================================================ */
+    {
+        static const EmbeddedRenderBackend be = {fill_cb, copy_cb, blend_cb, NULL, NULL, NULL};
+        embedded_renderer_set_backend(&be);
+        EmbeddedRenderWorkers serial_hooks = hooks; /* a split capture claims its group under the lock */
+        serial_hooks.lock = host_lock;
+        serial_hooks.unlock = host_unlock;
+        embedded_renderer_set_workers(&serial_hooks);
+        ERNode* root = new_scene();
+        ERNode* group = er_node_create(ER_NODE_VIEW);
+        ERProps gp = auto_props();
+        gp.position = ER_POS_ABSOLUTE;
+        gp.width = FB_W;
+        gp.height = FB_H;
+        gp.background_color = 0xFF0E7490U;
+        er_node_set_props(group, &gp);
+        for (int i = 0; i < 6; i++)
+        {
+            /* Boxes across the slice boundaries, some translucent, one rounded. */
+            ERNode* box = er_node_create(ER_NODE_VIEW);
+            ERProps bp = auto_props();
+            bp.position = ER_POS_ABSOLUTE;
+            bp.left = (int16_t)(4 + i * 9);
+            bp.top = (int16_t)(3 + i * 8);
+            bp.width = 14;
+            bp.height = 19;
+            bp.border_radius = i == 2 ? 5 : 0;
+            bp.background_color = (i % 2 ? 0x99000000U : 0xFF000000U) | (uint32_t)(0x2F6BD3U * (uint32_t)(i + 1) & 0xFFFFFFU);
+            er_node_set_props(box, &bp);
+            er_tree_append_child(group, box);
+        }
+        er_tree_append_child(root, group);
+        ERNode* tab = er_node_create(ER_NODE_VIEW);
+        ERProps tp2 = auto_props();
+        tp2.position = ER_POS_ABSOLUTE;
+        tp2.left = 30;
+        tp2.top = 24;
+        tp2.width = 20;
+        tp2.height = 16; /* rows 24-39, across the boundary of two slices */
+        tp2.background_color = 0xFFFDE68AU;
+        er_node_set_props(tab, &tp2);
+        er_tree_append_child(root, tab);
+        const ERAnimValueHandle fade = er_anim_value_create(1.0f);
+        er_anim_value_bind(fade, group, ER_PROP_OPACITY);
+        const ERAnimValueHandle dim = er_anim_value_create(1.0f);
+        er_anim_value_bind(dim, tab, ER_PROP_OPACITY);
+        er_commit();
