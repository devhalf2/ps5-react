+        static uint32_t fb_parallel[FB_W * FB_H];
+        const float alphas[] = {0.8f, 0.6f, 0.45f, 0.3f};
+        for (int i = 0; i < 4; i++)
+        {
+            const uint32_t forks = er_parallel_frames();
+            er_anim_value_set(fade, alphas[i]);
+            er_anim_value_set(dim, 1.0f - alphas[i] / 2.0f);
+            er_commit();
+            if (er_parallel_frames() != forks + 1)
+                return fail("fade cache: a frame of the fade rendered single-core");
+            if (i % 2 == 0)
