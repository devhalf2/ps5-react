Embedded React: letter spacing in 1/64 px, with 26.6 advances on the bitmap text path.

Modified from Embedded React (Apache-2.0, Copyright 2026 Cory Lamming) at the
revision pinned in dependencies.lock.json, after the patches listed before this
one there. Changed files: bridges/quickjs/native_ui_bridge.c,
engine/include/er_scene.h, engine/text/text_renderer.c,
engine/text/text_renderer.h and engine/tests/text/test_text.c. Not yet proposed
upstream.

letterSpacing was rounded to whole pixels at the bridge, so a fraction of a
pixel (the 0.2-0.4 px a glyph that separates a font's spacing from the PS5's
own at some sizes) could not be set at all. The bridge now keeps JS
letterSpacing in 1/64 px (int16, clamped, never the inherit sentinel), and the
bitmap text path runs its advances, pens and widths in 26.6 fixed point: each
glyph is drawn at its pen rounded to the nearest pixel, and a width leaves the
text code rounded up so a box fits its text. With no letter spacing every
advance is a whole number of pixels, so text draws and measures exactly as
before.

diff --git a/bridges/quickjs/native_ui_bridge.c b/bridges/quickjs/native_ui_bridge.c
index 9a7a18c..909ee38 100644
--- a/bridges/quickjs/native_ui_bridge.c
+++ b/bridges/quickjs/native_ui_bridge.c
@@ -378,6 +378,38 @@ static bool to_dim(JSContext* ctx, JSValueConst v, int16_t* out)
     return true;
 }
 
+/**
+ * @brief Coerces a numeric JS letterSpacing (pixels, fractions allowed) to 1/64 px.
+ *
+ * Text advances run in 26.6 fixed point, so a fraction of a pixel of spacing adds up along a line.
+ * The result is clamped to int16 and never equals the INT16_MIN inherit sentinel.
+ *
+ * @param[in]  ctx  QuickJS context.
+ * @param[in]  v    JS value (expected numeric).
+ * @param[out] out  Receives the spacing in 1/64 px.
+ *
+ * @return true on a numeric value.
+ */
+static bool to_letter_spacing(JSContext* ctx, JSValueConst v, int16_t* out)
+{
+    if (!JS_IsNumber(v))
+    {
+        return false;
+    }
+    double d = 0.0;
+    if (JS_ToFloat64(ctx, &d, v) != 0 || d != d)
+    {
+        return false;
+    }
+    d = round(d * 64.0);
+    if (d > 32767.0)
+        d = 32767.0;
+    if (d < -32767.0)
+        d = -32767.0;
+    *out = (int16_t)d;
+    return true;
+}
+
 /**
  * @brief Maps a single hex character to its 0–15 value.
  *
@@ -2408,7 +2440,14 @@ static void apply_props(JSContext* ctx, ERNode* node, JSValueConst obj)
     ER_U8(PROP_NUMBER_OF_LINES, number_of_lines);
     ER_ENUM(PROP_ELLIPSIZE_MODE, ellipsize_mode, map_ellipsize);
     ER_DIM(PROP_LINE_HEIGHT, line_height);
-    ER_DIM(PROP_LETTER_SPACING, letter_spacing);
+    {
+        JSValueConst _v = s_prop_slots[PROP_LETTER_SPACING];
+        int16_t _ls;
+        if (!JS_IsUndefined(_v) && to_letter_spacing(ctx, _v, &_ls))
+        {
+            p.letter_spacing = _ls;
+        }
+    }
 
     /* Image. */
     ER_STR(PROP_IMAGE_NAME, image_name, ER_IMAGE_NAME_MAX);
@@ -3641,10 +3680,10 @@ ER_BRIDGE_MARSHAL_FN(js_set_text_spans)
         }
         if (prop_get(ctx, seg, "letterSpacing", &v))
         {
-            int32_t ls = 0;
-            if (JS_ToInt32(ctx, &ls, v) == 0)
+            int16_t ls = 0;
+            if (to_letter_spacing(ctx, v, &ls))
             {
-                sp->letter_spacing = (int16_t)ls;
+                sp->letter_spacing = ls;
             }
             JS_FreeValue(ctx, v);
         }
