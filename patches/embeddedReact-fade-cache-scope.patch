+    /* -----------------------------------------------------------------------
+     * Fade cache scope: a change outside the fading group leaves its copy valid, and a change
+     * inside it, including a nested opacity value, must show. Same pixels with the cache off.
+     * ---------------------------------------------------------------------- */
+    reset(&tc);
+    {
+        er_reset();
+
+        ERNode* root = er_node_create(ER_NODE_VIEW);
+        ERProps rp = props_default();
+        rp.width = FB_W;
+        rp.height = FB_H;
+        rp.background_color = 0xFFFFFFFFU; /* white */
+        er_node_set_props(root, &rp);
+
+        ERNode* group = er_node_create(ER_NODE_VIEW);
+        ERProps gp = props_default();
+        gp.width = 16;
+        gp.height = 16;
+        gp.background_color = 0x00000000U;
+        er_node_set_props(group, &gp);
+
+        ERNode* child = er_node_create(ER_NODE_VIEW);
+        ERProps cp = props_default();
+        cp.width = 16;
+        cp.height = 16;
+        cp.background_color = 0xFFFF0000U; /* red */
+        er_node_set_props(child, &cp);
+
+        /* Outside the group, below it in the tree order: a 16x16 box at (16, 16). */
+        ERNode* other = er_node_create(ER_NODE_VIEW);
+        ERProps op = props_default();
+        op.width = 16;
+        op.height = 16;
+        op.position = ER_POS_ABSOLUTE;
+        op.left = 16;
+        op.top = 16;
+        op.background_color = 0xFF00FF00U; /* green */
+        er_node_set_props(other, &op);
+
+        er_tree_append_child(group, child);
+        er_tree_append_child(root, group);
+        er_tree_append_child(root, other);
+        er_tree_set_root(root);
+        er_commit();
+
+        ERAnimValueHandle alpha = er_anim_value_create(0.5f);
+        er_anim_value_bind(alpha, group, ER_PROP_OPACITY);
+        er_commit(); /* capture */
+        er_anim_value_set(alpha, 0.25f);
+        er_commit(); /* hit */
+        if (px(&tc, 2, 2) != 0xFFFFBFBFU)
+            return fail("fade cache scope: red at alpha 64");
+
+        /* A content change outside the group, mid-fade. */
+        op.background_color = 0xFF0000FFU; /* blue */
+        er_node_set_props(other, &op);
+        er_anim_value_set(alpha, 0.5f);
+        er_commit();
+        if (px(&tc, 2, 2) != 0xFFFF7F7FU)
+            return fail("fade cache scope: red at alpha 128 after a change outside the group");
+        if (px(&tc, 20, 20) != 0xFF0000FFU)
+            return fail("fade cache scope: the change outside the group must show");
+
+        /* A nested opacity value inside the group, mid-fade: the copy must not hide it. */
+        ERAnimValueHandle inner = er_anim_value_create(1.0f);
+        er_anim_value_bind(inner, child, ER_PROP_OPACITY);
+        er_commit();
+        er_anim_value_set(inner, 0.0f);
+        er_commit();
+        if (px(&tc, 2, 2) != 0xFFFFFFFFU)
+            return fail("fade cache scope: a nested opacity of 0 inside the group must show (stale cache?)");
+
+        er_anim_value_destroy(inner);
+        er_anim_value_destroy(alpha);
+        er_tree_remove_child(group, child);
+        er_tree_remove_child(root, group);
+        er_tree_remove_child(root, other);
+        er_node_destroy(child);
+        er_node_destroy(group);
+        er_node_destroy(other);
+        er_node_destroy(root);
+    }
