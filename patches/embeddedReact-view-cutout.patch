+/** @brief Sets a clipped framebuffer rect to transparent black (a cutout). */
+static void clear_rect_cb(int x, int y, int w, int h, void* ctx)
+{
+    SoftCtx* c = ctx;
+    if (!clip_rect(&x, &y, &w, &h, NULL, NULL))
+        return;
+    for (int row = 0; row < h; row++)
+        memset(c->fb + (size_t)(y + row) * c->fb_w + x, 0, (size_t)w * sizeof(uint32_t));
+}
