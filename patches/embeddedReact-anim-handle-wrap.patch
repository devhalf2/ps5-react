         er_node_destroy(other);
     }
 
+    /* -----------------------------------------------------------------------
+     * HANDLE WRAP: past 65535 handles, one still held is not given again
+     * ---------------------------------------------------------------------- */
+    {
+        ERNode* kept = er_node_create(ER_NODE_VIEW);
+        ERNode* churn = er_node_create(ER_NODE_VIEW);
+        ERProps wp = props_default();
+        wp.width = 10;
+        wp.height = 10;
+        er_node_set_props(kept, &wp);
+        er_node_set_props(churn, &wp);
+
+        /* A value that lives for the whole session (a header's), then a long session of values that come
+         * and go (cards mounting as a grid scrolls), enough to wrap the 16-bit handle counter. */
+        ERAnimValueHandle old = er_anim_value_create(0.0f);
+        if (old == ER_ANIM_VALUE_INVALID)
+            return fail("wrap: er_anim_value_create returned INVALID");
+        er_anim_value_bind(old, kept, ER_PROP_TRANSLATE_X);
+        er_anim_value_set(old, 10.0f);
+        for (int i = 0; i < 70000; i++)
+        {
+            ERAnimValueHandle h = er_anim_value_create(0.0f);
+            if (h == ER_ANIM_VALUE_INVALID)
+                return fail("wrap: the value pool filled with one value created and destroyed at a time");
+            if (h == old)
+                return fail("wrap: a handle still held was given to a new value");
+            er_anim_value_bind(h, churn, ER_PROP_TRANSLATE_X);
+            er_anim_value_set(h, 50.0f);
+            er_anim_value_destroy(h);
+        }
+        if (kept->tp_translate_x < 9.9f || kept->tp_translate_x > 10.1f)
+            return fail("wrap: a new value drove a property bound to an older one");
+        er_anim_value_set(old, 20.0f);
+        if (kept->tp_translate_x < 19.9f || kept->tp_translate_x > 20.1f)
+            return fail("wrap: the older value stopped driving its own property");
+
+        er_anim_value_destroy(old);
+        er_node_destroy(kept);
+        er_node_destroy(churn);
+    }
+
     return EXIT_SUCCESS;
 }
