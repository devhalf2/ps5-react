+++ b/bridges/quickjs/native_ui_bridge.c
@@ -152,6 +152,9 @@ static JSValue s_timer_handlers;
 /** @brief Per-slot "in use" flags for pending animation-completion callbacks. */
 static bool s_anim_complete_active[ER_BRIDGE_MAX_ANIM_COMPLETIONS];
 
+/** @brief Per-slot count of claims, so a caller can tell its claim from a later one of the same slot. */
+static uint32_t s_anim_complete_claims[ER_BRIDGE_MAX_ANIM_COMPLETIONS];
+
 /**
  * @brief JS object mapping a completion slot index to the `.start()` callback.
  *
@@ -4989,6 +4992,8 @@ static JSValue js_anim_value_animate(JSContext* ctx, JSValueConst this_val, int
     ERAnimConfig cfg;
     marshal_anim_config(ctx, argc > 2 ? argv[2] : JS_UNDEFINED, &cfg);
 
+    int claimed = -1;
+    uint32_t claim = 0;
     /* Optional completion callback (argv[3]): grab a slot, root the callback, and route the
        engine's on_complete through the trampoline. Must be registered BEFORE er_anim_value_animate,
        which may synchronously cancel a superseded animation (firing that one's callback). */
@@ -5006,6 +5011,8 @@ static JSValue js_anim_value_animate(JSContext* ctx, JSValueConst this_val, int
         if (slot >= 0)
         {
             s_anim_complete_active[slot] = true;
+            claimed = slot;
+            claim = ++s_anim_complete_claims[slot];
             JS_SetPropertyUint32(ctx, s_anim_complete_handlers, (uint32_t)slot, JS_DupValue(ctx, argv[3]));
             cfg.on_complete = bridge_anim_complete_trampoline;
             cfg.on_complete_user_data = (void*)(uintptr_t)slot;
@@ -5017,6 +5024,15 @@ static JSValue js_anim_value_animate(JSContext* ctx, JSValueConst this_val, int
     }
 
     const ERAnimHandle ah = er_anim_value_animate((ERAnimValueHandle)vh, (float)to_value, &cfg);
+    /* The engine drops an animation it cannot run (its value is gone, or every animation slot is busy)
+       without calling on_complete. The callback then held its slot for good, and once the pool was full
+       no animation told JS it had ended. It is told now, as a stopped one; a slot the callback already
+       freed and another animation claimed again is not this one's. */
+    if (ah == ER_ANIM_HANDLE_INVALID && claimed >= 0 && s_anim_complete_active[claimed]
+        && s_anim_complete_claims[claimed] == claim)
+    {
+        bridge_anim_complete_trampoline(false, (void*)(uintptr_t)claimed);
+    }
     return JS_NewInt32(ctx, (int32_t)ah);
 }
 
diff --git a/engine/animation/animation.c b/engine/animation/animation.c
index a8551e5..9de34be 100644
--- a/engine/animation/animation.c
+++ b/engine/animation/animation.c
@@ -199,17 +199,53 @@ void er_anim_reset(void)
  - Functions: Private — handle allocation
  ---------------------------------------------------------------------------------------------------------------------*/
 
+/**
+ * @brief Whether a live value, animation or group holds `handle`.
+ *
+ * @param[in] handle  Handle to look for.
+ *
+ * @return true when one of the three pools holds it.
+ */
+static bool handle_in_use(uint16_t handle)
+{
+    for (int i = 0; i < ERUI_MAX_ANIM_VALUES; i++)
+        if (s_anim_values[i].in_use && s_anim_values[i].handle == handle)
+            return true;
+    for (int i = 0; i < ERUI_MAX_ANIMATIONS; i++)
+        if (s_animations[i].active && s_animations[i].handle == handle)
+            return true;
+    for (int i = 0; i < ERUI_MAX_ANIM_GROUPS; i++)
+        if (s_groups[i].active && s_groups[i].handle == handle)
+            return true;
+    return false;
+}
+
 /**
  * @brief Allocates a unique animation handle.
  *
+ * Values, animations and groups share one 16-bit counter, and every animation started takes a
+ * handle, so a long session wraps it (a store's grid scrolled for minutes takes tens of thousands).
+ * Once it has wrapped, handles still held are skipped: a handle given twice made lookups find the
+ * older owner, so a new value bound and drove another element's property, and destroying it freed
+ * the older value and leaked its own slot until the pool was full. The pools hold far fewer than
+ * 65535 entries, so a free handle is always found.
+ *
  * @return Non-zero handle.
  */
 static uint16_t alloc_handle(void)
 {
-    uint16_t h = s_next_handle++;
-    if (s_next_handle == 0)
-        s_next_handle = 1;
-    return h;
+    static bool wrapped = false;
+    for (;;)
+    {
+        uint16_t h = s_next_handle++;
+        if (s_next_handle == 0)
+        {
+            s_next_handle = 1;
+            wrapped = true;
+        }
+        if (!wrapped || !handle_in_use(h))
+            return h;
+    }
 }
 
