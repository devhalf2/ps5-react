+
+// Runtime e2e: an animation the engine cannot run (its value is gone) still ends for JS, with
+// { finished: false }, and gives its completion slot back. Before, the callback held its slot for
+// good, and once the bridge's pool was full no animation reported its end.
+import {Animated, Easing} from 'embedded-react';
+import {check, report} from './harness.js';
+
+const lin = {duration: 100, easing: Easing.linear};
+
+{
+  const gone = new Animated.Value(0);
+  gone.destroy();
+  let result = null;
+  Animated.timing(gone, {toValue: 1, ...lin}).start(r => (result = r));
+  check(result && result.finished === false, 'an animation of a destroyed value ends at once, not finished');
+
+  // More of them than the completion pool holds.
+  let ended = 0;
+  for (let i = 0; i < 300; i++) Animated.timing(gone, {toValue: 1, ...lin}).start(() => ended++);
+  check(ended === 300, 'every dropped animation ends');
+
+  const live = new Animated.Value(0);
+  let done = null;
+  Animated.timing(live, {toValue: 100, ...lin}).start(r => (done = r));
+  NativeUI.tick(120);
+  check(done && done.finished === true, 'after them, a live animation still reports its end');
+}
+
+report('anim-dropped');
