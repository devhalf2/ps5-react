+/**
+ * Lifts 8-bit coverage to 255 * (cov / 255)^(1 / gamma), rounded: 0 and 255 stay, partial pixels grow.
+ *
+ * @param {Uint8Array|number[]} cov  Coverage, one byte per pixel.
+ * @param {number} gamma             1 returns `cov` unchanged.
+ * @returns {Uint8Array|number[]}
+ */
+export function applyCoverageGamma(cov, gamma) {
+  if (gamma === 1) return cov;
+  const table = Array.from({length: 256}, (_, c) => Math.round(255 * (c / 255) ** (1 / gamma)));
+  return Array.from(cov, c => table[c]);
+}
